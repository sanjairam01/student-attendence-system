# =========================================================
# SMART ATTENDANCE SYSTEM - PRODUCTION ENVIRONMENT VARIABLES
# =========================================================

# Server Configuration
PORT=3000
NODE_ENV=production
APP_NAME="Smart Attendance Management System"
APP_URL=http://localhost:3000

# Database Configuration (MySQL / Cloud SQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=attendance_user
DB_PASSWORD=UserPassword123!
DB_NAME=smart_attendance_db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis Cache & Rate Limiter Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=RedisEnterpriseSecret123!
REDIS_DB=0

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_enterprise_2026_smart_attendance
JWT_EXPIRATION_HOURS=24
BCRYPT_SALT_ROUNDS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Gemini AI Engine Key (Server-Side Only)
GEMINI_API_KEY=

# System Backup Settings
BACKUP_DIR=/app/backups
AUTO_BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
